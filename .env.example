# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so it never ships to the repo.

# PostHog analytics — public project key (safe to expose client-side).
# Get it from https://us.posthog.com → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
# Use /ingest to route through the Next.js reverse proxy (see next.config.ts).
# Set to https://us.i.posthog.com if you want direct ingestion instead.
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Notion integration for /guides lead capture (see src/app/api/guide-download).
# 1. Create a Notion integration at https://www.notion.so/profile/integrations
# 2. Copy the Internal Integration Secret (format: ntn_... or secret_...)
# 3. Share the "Guide Leads" database with the integration (DB → ⋯ → Connections)
NOTION_API_KEY=ntn_your_integration_secret_here
# The 32-char hex UUID of the Guide Leads database. Find it in the DB URL
# between the last `/` and the `?v=` query string.
NOTION_GUIDE_LEADS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sanity CMS — project ID is public (visible in client bundles). Create a
# project at https://www.sanity.io/manage and paste the ID below. Dataset
# stays "production" unless you set up separate environments.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
